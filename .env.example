# Copy to .env (never committed; Claude Code is denied reading it). Code loads it
# through pydantic-settings. Never paste these values into the brain, a commit or a chat,
# and never export them in a shell that runs Claude Code.

# Keys: MX0 now (recording runs); MX3 at deploy.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

MODEL_READER=claude-sonnet-5-5
MODEL_CHECKER=claude-haiku-5-5
JEV_MODEL=typesafe/jev-1.13
JEV_ENABLED=1

# record | replay | live. Tests and the hub always use replay.
CACHE_MODE=replay

# Local Postgres from compose.yaml. At deploy (MX3 only): Neon's direct connection string.
DATABASE_URL=postgresql://alinka:alinka@localhost:5432/alinka

# Deploy only (MX3): openssl rand -hex 32 for each.
EDGE_SECRET=
ADMIN_TOKEN=
APP_SECRET=
