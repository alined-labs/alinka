# The Alinka API image (Lane P deploys it). Build from the repository root:
#   docker build -f docker/Dockerfile.api -t alinka-api .
# Runtime config comes from the environment: DATABASE_URL, EDGE_SECRET, ADMIN_TOKEN.

# --- Build: resolve the locked environment with uv -------------------------------
FROM python:3.12-slim-trixie AS builder
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-default-groups --no-install-project
COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-default-groups

# --- Runtime: Python, Tesseract with Spanish and English, no uv ------------------
FROM python:3.12-slim-trixie
RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 999 alinka \
 && useradd --system --gid 999 --uid 999 --no-create-home alinka
COPY --from=builder --chown=alinka:alinka /app /app
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 CACHE_MODE=replay WEB_CONCURRENCY=2
USER alinka
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/api/health', timeout=4)"]
# Apply migrations, then serve. The canonical run is loaded on the first request
# (or ahead of time with `python -m alinka.api.load_run <name>`).
CMD ["sh", "-c", "python -m alinka.db migrate && exec uvicorn alinka.api.app:app --host 0.0.0.0 --port 8000 --workers \"$WEB_CONCURRENCY\" --proxy-headers --forwarded-allow-ips='*'"]
