// alinka-edge on alinka.alinedlabs.co (P5): the built front end and the frozen API, both from
// web/build/client (the API's recorded answers are its snapshot/ folder). Deploy with
// deploy/edge.sh, which builds web/ first.
{
  "name": "alinka-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/build/client",
    "binding": "ASSETS",
    // The API never falls through to a file, and /media/* goes through the Worker so the video
    // can be read in byte ranges; every other path tries the files first.
    "run_worker_first": ["/api/*", "/media/*"],
    // /como-funciona serves como-funciona/index.html (a prerendered page) without a redirect.
    "html_handling": "drop-trailing-slash",
    // Misses reach the Worker, which picks React Router's SPA fallback.
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "alinka.alinedlabs.co", "custom_domain": true }],
  // The keep-alive ping for Neon went with the database. An empty list removes the deployed
  // cron on the next deploy; leaving "triggers" out would keep it running.
  "triggers": { "crons": [] },
  "workers_dev": false,
  "preview_urls": false
}
