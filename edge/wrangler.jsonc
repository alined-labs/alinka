// alinka-edge on alinka.alinedlabs.co (P5). Deploy with deploy/edge.sh, which builds web/ first.
{
  "name": "alinka-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/build/client",
    "binding": "ASSETS",
    // The API never falls through to a file; every other path tries the files first.
    "run_worker_first": ["/api/*"],
    // /como-funciona serves como-funciona/index.html (a prerendered page) without a redirect.
    "html_handling": "drop-trailing-slash",
    // Misses reach the Worker, which picks React Router's SPA fallback.
    "not_found_handling": "none"
  },
  "vars": {
    "API_ORIGIN": "https://alinka-api.salmonfield-cee7654d.eastus2.azurecontainerapps.io"
  },
  "routes": [{ "pattern": "alinka.alinedlabs.co", "custom_domain": true }],
  // Keeps Neon awake through judging (Neon suspends after 5 idle minutes); drop it afterwards.
  "triggers": { "crons": ["*/4 * * * *"] },
  "workers_dev": false,
  "preview_urls": false
}
